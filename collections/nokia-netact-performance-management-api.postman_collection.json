  "item": [
    {
      "id": "a17717ca-1815-4323-93be-381b75221908",
      "name": "Performance Management",
      "description": {
        "content": "KPI and PM counter retrieval",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "4184fff1-dd06-4cd0-86da-01b67d705dbf",
          "name": "Get KPI performance counters",
          "request": {
            "name": "Get KPI performance counters",
            "description": {
              "content": "Retrieve performance measurement (PM) counter values and derived KPIs for network elements. Supports filtering by NE, KPI group, and time granularity (15-min, 1-hour, daily).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "performance",
                "kpis"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "neDn",
                  "value": "<string>",
                  "description": "(Required) DN of the network element or subtree root"
                },
                {
                  "disabled": false,
                  "key": "kpiGroup",
                  "value": "<string>",
                  "description": "KPI group name (e.g., ACCESSIBILITY, RETAINABILITY, TRAFFIC)"
                },
                {
                  "disabled": false,
                  "key": "granularity",
                  "value": "PT1H",
                  "description": "Measurement granularity (ISO 8601 duration)"
                },
                {
                  "disabled": false,
                  "key": "startTime",
                  "value": "<dateTime>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "endTime",
                  "value": "<dateTime>",
                  "description": "(Required) "
                }
              ],
              "variable": [
                {
                  "description": "Nokia NetAct server hostname",
                  "type": "any",
                  "value": "{{netact-host}}",
                  "key": "netact-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "686b4d80-76bd-4ce7-8c7e-5351d7db88dd",
              "name": "KPI measurement results",
